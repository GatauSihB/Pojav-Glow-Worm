<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <net.kdt.pojavlaunch.firefly.prefs.BackButtonPreference />

    <PreferenceCategory
        android:title="@string/preference_launcher_title"
        app2:iconSpaceReserved="false"
        >

        <Preference
            android:key="update_launcher"
            android:title="@string/preference_update_launcher_title"
            android:summary="@string/preference_update_launcher_desc"
            app2:iconSpaceReserved="false"
            />

        <SwitchPreference
            android:title="@string/preference_force_english_title"
            android:key="force_english"
            android:summary="@string/preference_force_english_description"
            app2:iconSpaceReserved="false"
            />

        <SwitchPreference
            android:defaultValue="false"
            android:key="enableLogOutput"
            android:summary="@string/preference_enable_log_output_desc"
            android:title="@string/preference_enable_log_output_title"
            app2:iconSpaceReserved="false"
            />

        <SwitchPreference
            android:defaultValue="true"
            android:key="quitLauncher"
            android:summary="@string/preference_quit_launcher"
            android:title="@string/preference_quit_launcher_title"
            app2:iconSpaceReserved="false"
            />

        <SwitchPreference
            android:defaultValue="true"
            android:key="autoSetGameLanguage"
            android:summary="@string/zh_setting_set_game_language_desc"
            android:title="@string/zh_setting_set_game_language_title"
            app2:iconSpaceReserved="false"
            />

        <SwitchPreference
            android:defaultValue="false"
            android:key="gameLanguageOverridden"
            android:summary="@string/zh_setting_set_game_language_overridden_desc"
            android:title="@string/zh_setting_set_game_language_overridden_title"
            app2:iconSpaceReserved="false"
            />

        <androidx.preference.ListPreference
            android:key="setGameLanguage"
            android:entries="@array/all_game_language"
            android:entryValues="@array/all_game_language_value"
            android:title="@string/zh_setting_set_game_language_list"
            android:defaultValue="system"
            app2:useSimpleSummaryProvider="true"
            app2:iconSpaceReserved="false"/>

        <PreferenceCategory
            android:title="@string/preference_settings_button_title"
            app2:iconSpaceReserved="false">

            <SwitchPreference
                android:defaultValue="true"
                android:key="settingsButtonVisible"
                android:summary="@string/preference_settings_button_visible_desc"
                android:title="@string/preference_settings_button_visible_title"
                app2:iconSpaceReserved="false"/>

            <androidx.preference.ListPreference
                android:defaultValue="top_end"
                android:key="settingsButtonPosition"
                android:entries="@array/settings_button_position"
                android:entryValues="@array/settings_button_position_value"
                android:summary="%s"
                android:title="@string/preference_settings_button_position_title"
                app2:iconSpaceReserved="false"/>

            <net.kdt.pojavlaunch.firefly.prefs.CustomSeekBarPreference
                android:key="settingsButtonYOffset"
                android:title="@string/preference_settings_button_y_offset_title"
                android:summary="@string/preference_settings_button_y_offset_desc"
                app2:min="0"
                app2:defaultValue="0"
                app2:seekBarIncrement="5"
                app2:showSeekBarValue="true"
                app2:iconSpaceReserved="false"/>

            <net.kdt.pojavlaunch.firefly.prefs.CustomSeekBarPreference
                android:key="settingsButtonScale"
                android:title="@string/preference_settings_button_scale_title"
                android:summary="@string/preference_settings_button_scale_desc"
                app2:min="50"
                app2:defaultValue="100"
                app2:seekBarIncrement="5"
                app2:showSeekBarValue="true"
                app2:iconSpaceReserved="false"/>

        </PreferenceCategory>

    </PreferenceCategory>

</PreferenceScreen>

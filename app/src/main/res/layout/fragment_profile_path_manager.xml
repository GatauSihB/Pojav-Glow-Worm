<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient_violet">

    <!-- Top Glass Header -->
    <View
        android:id="@+id/path_top_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_64sdp"
        android:background="@drawable/background_panel"
        android:elevation="@dimen/_4sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/path_manager_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:text="@string/profiles_path_title"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/path_top_bar_bg"
        app:layout_constraintBottom_toBottomOf="@id/path_top_bar_bg" />

    <ImageButton
        android:id="@+id/profile_path_return_button"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/background_pill"
        android:foreground="?android:attr/selectableItemBackground"
        android:contentDescription="@string/global_return"
        android:padding="@dimen/_10sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/path_top_bar_bg"
        app:layout_constraintBottom_toBottomOf="@id/path_top_bar_bg" />

    <!-- Paths RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profile_path"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@id/path_top_bar_bg"
        app:layout_constraintBottom_toTopOf="@id/path_bottom_bar_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Glass Bar -->
    <View
        android:id="@+id/path_bottom_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_72sdp"
        android:background="@drawable/background_panel"
        android:elevation="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_24sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/path_bottom_bar_bg">

        <ImageButton
            android:id="@+id/profile_path_refresh_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_weight="1"
            android:layout_margin="@dimen/_8sdp"
            android:background="@drawable/background_pill"
            android:foreground="?android:attr/selectableItemBackground"
            android:contentDescription="@string/global_refresh"
            android:padding="@dimen/_12sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/profile_path_create_new_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_weight="1"
            android:layout_margin="@dimen/_8sdp"
            android:background="@drawable/background_pill"
            android:foreground="?android:attr/selectableItemBackground"
            android:contentDescription="@string/profiles_path_create_new"
            android:padding="@dimen/_12sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
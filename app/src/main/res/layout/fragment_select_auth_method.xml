<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient_violet"
    android:paddingHorizontal="@dimen/_24sdp">

    <androidx.cardview.widget.CardView
        android:id="@+id/auth_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_panel"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="@dimen/_12sdp"
        app:cardCornerRadius="@dimen/_20sdp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_32sdp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/ic_menu_settings"
                android:tint="@color/violet_accent"
                android:layout_marginBottom="@dimen/_16sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_choose_method"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_22ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="@dimen/_8sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_choose_method_desc"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_12ssp"
                android:gravity="center"
                android:layout_marginBottom="@dimen/_24sdp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/button_microsoft_authentication"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:text="@string/preference_category_microsoft_account_title"
                android:textAllCaps="true"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_14ssp"
                android:drawableStart="@drawable/ic_microsoft"
                android:drawablePadding="@dimen/_12sdp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/button_local_authentication"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:text="@string/preference_category_local_account_title"
                android:textAllCaps="true"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_14ssp"
                android:drawableStart="@drawable/ic_folder"
                android:drawablePadding="@dimen/_12sdp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/button_other_authentication"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:text="@string/other_login_api"
                android:textAllCaps="true"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_14ssp"
                android:drawableStart="@drawable/ic_folder"
                android:drawablePadding="@dimen/_12sdp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
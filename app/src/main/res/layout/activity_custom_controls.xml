<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customctrl_drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient_violet">

    <!-- Main content: Control canvas + top glass bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top glass header bar -->
        <View
            android:id="@+id/top_glass_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:background="@drawable/background_panel"
            android:elevation="@dimen/_4sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/editor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:text="@string/mcl_option_customcontrol"
            android:textAllCaps="true"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/top_glass_bar"
            app:layout_constraintBottom_toBottomOf="@id/top_glass_bar" />

        <!-- Open drawer button -->
        <ImageButton
            android:id="@+id/drawer_button"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/background_pill"
            android:foreground="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_menu_custom_controls"
            android:scaleType="centerInside"
            android:padding="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/top_glass_bar"
            app:layout_constraintBottom_toBottomOf="@id/top_glass_bar" />

        <!-- Main control canvas (full screen below header) -->
        <net.kdt.pojavlaunch.firefly.customcontrols.ControlLayout
            android:id="@+id/customctrl_controllayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/top_glass_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right drawer: Glass panel with controls list + GLOBAL SCALE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drawer_content"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@android:color/transparent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_panel"
            android:layout_margin="@dimen/_8sdp"
            android:elevation="@dimen/_8sdp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/_12sdp"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingBottom="@dimen/_24sdp">

                <!-- Section: Global Scale -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:text="@string/control_global_scale"
                    android:textAllCaps="true"
                    android:textColor="@color/violet_accent_light"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_8sdp">

                    <TextView
                        android:id="@+id/scale_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold"
                        android:minWidth="@dimen/_40sdp"
                        android:gravity="end" />

                    <SeekBar
                        android:id="@+id/global_scale_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:max="200"
                        android:progress="100"
                        android:thumbTint="@color/violet_accent"
                        android:progressTint="@color/violet_accent_light"
                        android:progressBackgroundTint="@color/glass_stroke" />

                    <TextView
                        android:id="@+id/scale_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/_11ssp"
                        android:minWidth="@dimen/_40sdp" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:background="@color/glass_stroke" />

                <!-- Section: Button Visibility -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:text="@string/preference_category_button_visibility"
                    android:textAllCaps="true"
                    android:textColor="@color/violet_accent_light"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/preference_show_button_labels_title"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/showButtonLabel_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/violet_accent"
                        android:trackTint="@color/violet_accent_light" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/preference_android_cursor_title"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/androidMouseCursor_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/violet_accent"
                        android:trackTint="@color/violet_accent_light" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:background="@color/glass_stroke" />

                <!-- Section: Add Controls -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:text="@string/customctrl_add_controls"
                    android:textAllCaps="true"
                    android:textColor="@color/violet_accent_light"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/controls_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_8sdp">

                    <!-- Buttons generated dynamically from strings array -->

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:background="@color/glass_stroke" />

                <!-- Section: Layout Actions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:text="@string/customctrl_layout_actions"
                    android:textAllCaps="true"
                    android:textColor="@color/violet_accent_light"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/actions_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_8sdp">

                    <!-- Buttons generated dynamically from strings array -->

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>
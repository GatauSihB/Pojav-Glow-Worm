<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_6sdp"
    android:background="@drawable/background_list_item"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="@dimen/_2sdp"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mod_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mod_item_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_11ssp" />

        </LinearLayout>

    <com.kdt.mcgui.MineButton
        android:id="@+id/mod_item_toggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:minWidth="@dimen/_76sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:text="@string/mods_disable"
        android:textAllCaps="true"
        android:textSize="@dimen/_11ssp" />

    <ImageButton
        android:id="@+id/mod_item_delete"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/background_pill"
        android:foreground="?android:attr/selectableItemBackground"
        android:contentDescription="@string/global_delete"
        android:padding="@dimen/_8sdp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_menu_delete_forever" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
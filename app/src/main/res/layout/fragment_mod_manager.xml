<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient_violet">

    <!-- Top Glass Header -->
    <View
        android:id="@+id/mod_top_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_64sdp"
        android:background="@drawable/background_panel"
        android:elevation="@dimen/_4sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/mod_manager_back_button"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:background="@drawable/background_pill"
        android:foreground="?android:attr/selectableItemBackground"
        android:contentDescription="@string/global_back"
        android:padding="@dimen/_10sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/mod_top_bar_bg"
        app:layout_constraintBottom_toBottomOf="@id/mod_top_bar_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/mod_manager_back_button"
        app:layout_constraintEnd_toStartOf="@id/mod_manager_add_button"
        app:layout_constraintStart_toEndOf="@id/mod_manager_back_button"
        app:layout_constraintTop_toTopOf="@id/mod_manager_back_button">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mods_title"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mod_manager_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mod_manager_add_button"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/background_pill"
        android:foreground="?android:attr/selectableItemBackground"
        android:contentDescription="@string/mods_add"
        android:padding="@dimen/_10sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add_modded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mod_top_bar_bg"
        app:layout_constraintBottom_toBottomOf="@id/mod_top_bar_bg" />

    <!-- Mods RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mod_manager_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mod_top_bar_bg" />

    <!-- Empty State Glass Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mod_manager_empty_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_24sdp"
        android:background="@drawable/background_card"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="@dimen/_8sdp"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mod_top_bar_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/_32sdp">

            <ImageView
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:src="@drawable/ic_folder"
                android:tint="@color/secondary_text"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/mods_empty"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_14ssp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/mods_empty_subtitle"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_11ssp"
                android:alpha="0.7"
                android:gravity="center" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/empty_add_mod_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/mods_add"
                android:textAllCaps="true"
                android:textColor="@color/primary_text" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/background_gradient_violet">

    <!-- Left panel: compact two-column grid of launcher actions -->
    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/background_panel"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/play_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_6sdp"
            android:letterSpacing="0.15"
            android:text="@string/app_short_name"
            android:textAllCaps="true"
            android:textColor="@color/violet_accent_light"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:orientation="horizontal">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/about_launcher_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_menu_row"
                android:drawableStart="@drawable/ic_menu_news"
                android:text="@string/mcl_tab_about_launcher"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_menu_row"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:text="@string/mcl_option_customcontrol"
                android:textColor="@color/primary_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:orientation="horizontal">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_menu_row"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="@string/main_install_jar_file"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/start_terminal_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_menu_row"
                android:drawableStart="@drawable/ic_terminal"
                android:text="@string/main_terminal"
                android:textColor="@color/primary_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:orientation="horizontal">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_menu_row"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:text="@string/main_share_logs"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/mods_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_menu_row"
                android:drawableStart="@drawable/ic_folder"
                android:text="@string/mods_title"
                android:textColor="@color/primary_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right panel: quick launch card -->
    <LinearLayout
        android:id="@+id/play_panel"
        android:layout_width="@dimen/_300sdp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/background_panel"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_4sdp"
            android:letterSpacing="0.2"
            android:text="@string/quick_launch"
            android:textAllCaps="true"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/background_pill"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_14sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_28sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/path_manager_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_pill"
                android:foreground="?android:attr/selectableItemBackground"
                android:scaleType="centerInside"
                android:src="@drawable/ic_list" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/background_pill"
                android:foreground="?android:attr/selectableItemBackground"
                android:scaleType="centerInside"
                android:src="@drawable/ic_edit_profile" />
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textColor="@color/primary_text" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
